# Copie para .env e ajuste. Nunca versione o .env real.
NODE_ENV=development
PORT=3333
API_PREFIX=api
LOG_LEVEL=debug

# Banco local levantado por `pnpm infra:up`
DATABASE_URL="postgresql://arbora:arbora@localhost:5432/arbora?schema=public"

CORS_ORIGINS=http://localhost:3000

# Gere um valor forte: openssl rand -hex 32
JWT_SECRET=troque-este-segredo-por-um-valor-de-32-caracteres-ou-mais
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

SWAGGER_ENABLED=true
