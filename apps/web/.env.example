# Copie para .env.local. Variáveis NEXT_PUBLIC_* vão para o bundle do browser:
# nunca coloque segredos nelas.
# Dev: URL absoluta da API. Em staging/produção é `/api/v1` + API_ORIGIN (proxy do Next, ver
# src/lib/api-base.ts).
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
NEXT_PUBLIC_APP_NAME=Arbora
